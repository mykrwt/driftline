{
  "name": "driftline",
  "version": "1.0.0",
  "private": true,
  "description": "Driftline - a Slowroads-style pseudo-3D drift racer that runs in the browser on mobile and desktop, with serverless peer-to-peer multiplayer.",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "dev": "node tools/serve.mjs",
    "test": "node tools/run-tests.mjs",
    "test:watch": "node --test --watch tests/",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "node tools/e2e.mjs",
    "verify": "npm run check:imports && npm test",
    "check:imports": "node tools/check-imports.mjs",
    "terrain:map": "node tools/terrain-map.mjs",
    "scene:preview": "node tools/scene-preview.mjs",
    "bot:bench": "node tools/bot-bench.mjs",
    "car:preview": "node tools/car-preview.mjs"
  },
  "keywords": [
    "game",
    "racing",
    "drift",
    "pseudo-3d",
    "webrtc",
    "peer-to-peer",
    "mobile"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.21.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.186.1",
    "three-noise": "^1.1.2"
  }
}
